PORT=3001
MONGODB_URI=mongodb://localhost:27017/auth-service?retryWrites=false
NODE_ENV=development
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=5m
REFRESH_TOKEN_EXPIRES_IN_DAYS=15

# Credential-less shared demo account (POST /api/auth/demo-login). Off by
# default; set to "true" to enable. The demo organization itself must be
# provisioned separately (see repo-root scripts/seed-demo.mjs) - the
# endpoint answers 503 until it exists. The demo user is always forced to
# an active VIEWER membership of that org.
DEMO_LOGIN_ENABLED=false
DEMO_ORG_SLUG=crashlens-demo
DEMO_USER_EMAIL=demo@crashlens.online
