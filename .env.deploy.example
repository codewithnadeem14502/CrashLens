# Copy this to `.env` (git-ignored, never commit it) at the repo root and
# fill in real values before running `docker compose up`. This is the ONE
# env file docker-compose.yml reads via ${VAR} substitution - it is separate
# from each service's own .env.example (which documents that service's
# local-dev defaults).

# ---------------------------------------------------------------------------
# Domain (must already point at this VM's public IP via an A record)
# ---------------------------------------------------------------------------
DOMAIN=api.crashlens.online

# ---------------------------------------------------------------------------
# MongoDB Atlas - base connection string, WITHOUT a trailing database name or
# path. Each service appends its own /<service-name> in docker-compose.yml.
# Example: mongodb+srv://<user>:<password>@cluster0.1ydh1vq.mongodb.net
# Rotate the password in Atlas before pasting a real one here, and never
# paste it anywhere but this git-ignored file.
# ---------------------------------------------------------------------------
MONGODB_BASE_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net

# ---------------------------------------------------------------------------
# Shared auth secret - MUST be identical across api-gateway, auth-service,
# project-service, issue-service, monitor-service, and alert-service (auth
# signs tokens, the rest verify/mint them). Generate with e.g.:
#   openssl rand -hex 64
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# CORS - the exact origin(s) allowed to call the gateway from a browser.
# Must match the deployed frontend origin exactly (scheme + host, no
# trailing slash). Comma-separate if there's more than one.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://crash-lens-client.vercel.app

# ---------------------------------------------------------------------------
# Host segment written into every project DSN shown in the dashboard
# (crashlens://<key>@<host>/<projectId>). This is the origin a customer's app
# posts events to, so it must be this deployment's public gateway hostname.
# Defaults to DOMAIN above - only set it explicitly if the DSN host should
# differ from the gateway's own domain (e.g. a vanity ingest hostname).
# Leaving it wrong doesn't break ingestion, but every DSN the UI hands out
# will be unusable by the app that copies it.
# ---------------------------------------------------------------------------
# PUBLIC_DSN_HOST=api.crashlens.online

# ---------------------------------------------------------------------------
# alert-service email notifications (optional). Leave blank to disable -
# email actions then fail gracefully without affecting other alert actions.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@crashlens.local

# ---------------------------------------------------------------------------
# Shared demo account (POST /v1/auth/demo-login) - the "Try the live demo"
# button on the client. Set DEMO_LOGIN_ENABLED=true to turn it on.
#
# Enabling it is only half the job: the demo organization itself must be
# provisioned once, or the endpoint answers 503. Run the seeder against the
# deployed gateway (from anywhere that can reach it):
#   node scripts/seed-demo.mjs https://api.crashlens.online
# It's idempotent and writes the demo DSN / monitor checkToken / generated
# admin password to a 0600 .demo-credentials file.
#
# While enabled, DEMO_ORG_SLUG and DEMO_USER_EMAIL are reserved - nobody can
# register an organization or admin user using them.
# ---------------------------------------------------------------------------
DEMO_LOGIN_ENABLED=false
DEMO_ORG_SLUG=crashlens-demo
DEMO_USER_EMAIL=demo@crashlens.online
# Demo refresh tokens are short-lived (vs REFRESH_TOKEN_EXPIRES_IN_DAYS=15
# for real accounts) - this is an anonymous route that writes one token
# document per click.
DEMO_REFRESH_TOKEN_EXPIRES_IN_HOURS=2
